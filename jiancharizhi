#!/usr/bin/env python3
# game_test_log_exporter.py 游戏测试日志快速导出工具
# 原创，仅内置库，直接运行
import csv
import time
import os

LOG_FILE = "game_log.csv"
# 表头
HEADER = ["timestamp", "player_id", "event_type", "content", "tester_note"]

def init_log():
    # 文件不存在则新建并写入表头
    if not os.path.exists(LOG_FILE):
        with open(LOG_FILE, "w", encoding="utf-8-sig", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(HEADER)

def add_log():
    print("\n===== 新增游戏测试日志 =====")
    pid = input("玩家/对象ID：").strip()
    event = input("事件类型(BUG/卡顿/闪退/交互等)：").strip()
    content = input("事件描述：").strip()
    note = input("测试备注：").strip()
    ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())

    with open(LOG_FILE, "a", encoding="utf-8-sig", newline="") as f:
        writer = csv.writer(f)
        writer.writerow([ts, pid, event, content, note])
    print(f"✅ 日志已保存到 {LOG_FILE}")

def main():
    init_log()
    while True:
        print("\n===== 游戏日志导出工具 =====")
        print("1 录入新日志")
        print("0 退出")
        opt = input("请选择：").strip()
        if opt == "1":
            add_log()
        elif opt == "0":
            print("程序退出，日志文件已保存！")
            break
        else:
            print("输入无效，请重新选择")

if __name__ == "__main__":
    main()
